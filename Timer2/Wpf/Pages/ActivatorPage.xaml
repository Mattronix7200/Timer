<UserControl x:Class="TimerSys.Wpf.Pages.ActivatorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,22">
        <StackPanel>

            <Border x:Name="EditBanner"
                    Margin="0,0,0,14"
                    Padding="14,10"
                    CornerRadius="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LblEditBanner"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="LblMode" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="6" CornerRadius="0">
                <UniformGrid x:Name="ModeBar" Columns="3" />
            </Border>

            <TextBlock x:Name="LblIntro"
                       Margin="4,12,4,16"
                       Style="{StaticResource Hint}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LblAction" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboAction" Grid.Column="0" />
                            <Button x:Name="BtnActionSettings"
                                    Grid.Column="1"
                                    Width="38"
                                    Margin="8,0,0,0"
                                    Click="BtnActionSettings_Click"
                                    Style="{StaticResource SquareIconButton}" />
                        </Grid>

                        <StackPanel x:Name="PanelIdle" Margin="0,18,0,0">
                            <TextBlock x:Name="LblIdleTime" Style="{StaticResource SectionTitle}" />
                            <TextBox x:Name="TxtIdleTime" Width="160" HorizontalAlignment="Left" />
                            <TextBlock x:Name="LblIdleHint" Margin="2,6,0,0" Style="{StaticResource Hint}" />
                        </StackPanel>

                        <StackPanel x:Name="PanelTimer" Margin="0,18,0,0">
                            <Grid>
                                <TextBlock x:Name="LblTimerCaption"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitle}" />
                                <Button x:Name="BtnTimerMode"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,8"
                                        Padding="10,5"
                                        MinHeight="30"
                                        Click="BtnTimerMode_Click"
                                        Style="{StaticResource FlatButton}" />
                            </Grid>
                            <StackPanel x:Name="PanelDuration">
                                <TextBox x:Name="TxtDuration" Width="160" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LblDurationHint" Margin="2,6,0,0" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel x:Name="PanelDateTime">
                                <DatePicker x:Name="DatePick" Width="200" HorizontalAlignment="Left" />
                                <TextBox x:Name="TxtHour" Width="160" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LblHourHint" Margin="2,6,0,0" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelSchedule" Margin="0,18,0,0">
                            <TextBlock x:Name="LblSchedHour" Style="{StaticResource SectionTitle}" />
                            <TextBox x:Name="TxtSchedHour" Width="160" HorizontalAlignment="Left" />
                            <TextBlock x:Name="LblSchedHourHint" Margin="2,6,0,0" Style="{StaticResource Hint}" />

                            <TextBlock x:Name="LblRepeat" Margin="0,16,0,0" Style="{StaticResource SectionTitle}" />
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    CornerRadius="0"
                                    Background="{DynamicResource InputBrush}">
                                <ScrollViewer Height="132" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DaysPanel" Margin="10,8" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAdd"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnAdd_Click"
                                    Style="{StaticResource AccentButton}" />
                            <Button x:Name="BtnCancelEdit"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    MinWidth="120"
                                    Visibility="Collapsed"
                                    Click="BtnCancelEdit_Click"
                                    Style="{StaticResource FlatButton}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TipCard"
                        Grid.Column="1"
                        Width="250"
                        Margin="18,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="LblTipTitle"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="LblTipText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="SchedExtras" Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="LblSchedStatus" VerticalAlignment="Center" />
                        <Button x:Name="BtnSchedToggle"
                                HorizontalAlignment="Right"
                                Click="BtnSchedToggle_Click"
                                Style="{StaticResource FlatButton}" />
                    </Grid>
                    <Border Height="1" Margin="0,14" Background="{DynamicResource BorderBrush}" />
                    <TextBlock x:Name="LblSnooze" Margin="0,0,0,8" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CboSnooze" Width="170" />
                        <Button x:Name="BtnSnooze"
                                Margin="10,0,0,0"
                                MinWidth="130"
                                Click="BtnSnooze_Click"
                                Style="{StaticResource FlatButton}" />
                        <TextBlock x:Name="LblSnoozeStatus"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LblCountdown"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

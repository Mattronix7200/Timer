<UserControl x:Class="TimerSys.Wpf.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="LogoImage"
                       Grid.Column="0"
                       Height="46"
                       Margin="0,0,22,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LblVersion" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="LblAuthor" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="LblSupport"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Hint}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button x:Name="BtnSupport"
                                MinWidth="130"
                                MinHeight="34"
                                Click="BtnSupport_Click"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="6" CornerRadius="0" Style="{StaticResource Card}">
            <UniformGrid x:Name="TabBar" Columns="2" />
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LblContent"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           FontSize="13" />
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ButtonRow"
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal" />
    </Grid>
</UserControl>

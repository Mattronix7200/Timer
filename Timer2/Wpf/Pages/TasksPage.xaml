<UserControl x:Class="TimerSys.Wpf.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblHeader" Grid.Row="0" Style="{StaticResource SectionTitle}" />

        <Border Grid.Row="1" Padding="6" CornerRadius="0" Style="{StaticResource Card}">
            <UniformGrid x:Name="FilterBar" Columns="4" />
        </Border>

        <Grid x:Name="HeaderRow" Grid.Row="2" Margin="14,18,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="174" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ColTask" Grid.Column="0" Style="{StaticResource Hint}" />
            <TextBlock x:Name="ColRemaining" Grid.Column="1" Style="{StaticResource Hint}" />
            <TextBlock x:Name="ColState" Grid.Column="2" Style="{StaticResource Hint}" />
            <TextBlock x:Name="ColQueue" Grid.Column="3" Style="{StaticResource Hint}" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsPanel" />
            </ScrollViewer>
            <TextBlock x:Name="LblEmpty"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="420"
                       TextAlignment="Center"
                       Style="{StaticResource Hint}" />
        </Grid>

        <TextBlock x:Name="LblCount" Grid.Row="4" Margin="14,12,0,0" Style="{StaticResource Hint}" />
    </Grid>
</UserControl>
